{
  "name": "pokemonpedia",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build",
    "build:compact": "cross-env VITE_COMPACT_CATALOGUE=1 vite build",
    "build:server": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc",
    "data:sync": "tsx scripts/sync-pokemon-data.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:compact": "cross-env VITE_COMPACT_CATALOGUE=1 playwright test",
    "report:browser-engines": "tsx scripts/browser-engine-report.ts",
    "lint": "eslint client/src/pages client/src/components client/src/lib shared server scripts tests *.ts client/service-worker.js",
    "format": "prettier --write client/src shared server scripts tests *.ts *.json *.js README.md AGENTS.md .github/workflows/ci.yml client/service-worker.js client/public/manifest.webmanifest \"docs/*.md\" \"docs/*.json\"",
    "format:check": "prettier --check client/src shared server scripts tests *.ts *.json *.js README.md AGENTS.md .github/workflows/ci.yml client/service-worker.js client/public/manifest.webmanifest \"docs/*.md\" \"docs/*.json\"",
    "data:types": "tsx scripts/sync-type-chart.ts",
    "data:forms": "tsx scripts/sync-forms.ts",
    "data:reference": "tsx scripts/sync-reference.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:index": "tsx scripts/evaluate-catalogue.ts",
    "benchmark:catalogue": "tsx scripts/compare-catalogue-builds.ts",
    "validate:offline-transports": "tsx scripts/validate-offline-transports.ts",
    "benchmark:check": "tsx scripts/benchmark.ts --check --output=tmp/review/performance-check.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-shadcn-theme-json": "^0.0.4",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@replit/vite-plugin-cartographer": "^0.0.11",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
